# Copy this file to .env.local and fill in your key. Never commit .env.local.

# REQUIRED — OpenAI API key (https://platform.openai.com/api-keys).
# Used server-side only, for transcription and grammar analysis.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# Speech-to-text model for recorded audio. Alternatives: gpt-4o-transcribe, whisper-1 (both deprecated by OpenAI, shutdown Feb 2027).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Model used for grammar and speaking analysis. Faster/cheaper alternative: gpt-6-luna.
OPENAI_ANALYSIS_MODEL=gpt-6.2-sol
# Reasoning effort for the analysis model (leave empty to use the model's default).
OPENAI_REASONING_EFFORT=low
# How many sentences go into each parallel analysis request, and how many requests run at once.
ANALYSIS_BATCH_SIZE=8
OPENAI_MAX_CONCURRENCY=6

# Where the SQLite learning history (and any audio you explicitly keep) is stored.
# DATA_DIR=./data

# Only for tests: point at a mock server instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1
